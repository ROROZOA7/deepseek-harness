OPENCODE_GO_API_KEY=your_opencode_go_api_key
# Public DNS names routed by Cloudflare Tunnel.
# Create all three hostnames in Cloudflare Zero Trust and point them to this host.
DSH_PUBLIC_HOST=dsh.team.example.com
LAVISH_PUBLIC_HOST=lavish.team.example.com
OPEN_DESIGN_PUBLIC_HOST=design.team.example.com

# Keep origins reachable only through cloudflared/Caddy on this machine.
DSH_HTTP_PORT=8080
LAVISH_HTTP_PORT=4387
OPEN_DESIGN_PORT=7457
OD_ALLOWED_ORIGINS=https://design.team.example.com

# Paste the token from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# 1 = teammates behind the Caddy proxy may edit provider settings, credentials,
# and run model discovery after basic auth. 0 keeps those pages local-only.
DSH_ALLOW_REMOTE_CONFIGURATION=0

# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
CADDY_PASSWORD_HASH=replace-with-a-real-caddy-password-hash

# OpenDesign image and resource limits.
OPEN_DESIGN_IMAGE=dsh-team-open-design:local
OPEN_DESIGN_MEM_LIMIT=384m
OPEN_DESIGN_NODE_OPTIONS=--max-old-space-size=192
# Generate with: openssl rand -hex 32
OD_API_TOKEN=
# Credentials inherited by dsh when using the native DeepSeek provider.
DEEPSEEK_API_KEY=
